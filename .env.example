# Every variable the server reads. Required: the database URL, the three
# Supabase keys and SESSION_SECRET; the server refuses to boot without them
# (server/app.ts assertRequiredEnv). Everything else is optional.

# PostgreSQL — production: the Coolify database on the Hetzner host
# (README → Database on the Hetzner host). Local dev: any Postgres.
POSTGRES_URL=postgres://postgres:password@host:port/db?sslmode=require
# Alias read first: when both are set, DATABASE_URL wins (server/db.ts, scripts/migrate.ts).
# DATABASE_URL=
# TLS is on when the URL has an sslmode other than disable (or is a Supabase/Neon host).
# PGSSLMODE=require forces it on, PGSSLMODE=disable forces it off.
# PGSSLMODE=
# POSTGRES_SSL=true forces TLS on for the server only (the migration runner ignores it).
# POSTGRES_SSL=

# Supabase — Xpot's own project, used for Storage (uploads bucket) and for the
# Auth accounts behind the legacy email sign-in and the password change.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Express session
SESSION_SECRET=<long-random-string>

# Sign-in by phone: a code goes out by SMS through Twilio. Preferred: fill in Organization > Integrations > "Twilio | SMS" (stored in the database). The vars below are only a fallback
# used when that panel is empty. (Twilio: the same number
# Skale Club already sends notifications from). Without these, development
# prints the code in the server log; production can't send codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Or, instead of TWILIO_FROM_NUMBER:
# TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp shown to people waiting for approval or blocked ("talk to us").
XPOT_SUPPORT_WHATSAPP=+1XXXXXXXXXX
# Who gets a text when someone signs up and waits for approval (comma separated).
XPOT_SIGNUP_NOTIFY_PHONES=+1XXXXXXXXXX
# Origin used in that text's link to /admin/reps; unset, the request's own origin.
# XPOT_PUBLIC_URL=https://xpot.place

# Wholesale: kits are bought at the Stuscle store with the rep's personal
# code. Stuscle checks codes against Xpot with this shared secret (16+ chars,
# the same value as XPOT_WHOLESALE_SECRET in Stuscle). Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
XPOT_WHOLESALE_SECRET=
# The store, for the "Open the wholesale store" link.
STUSCLE_PUBLIC_URL=https://stuscle.com

# Server port — client + API are served from this single port
# (dev default 2110; the Docker image sets 8888 for Coolify).
PORT=2110

# Google Places API (business search at check-in, lead address autocomplete).
# The key saved in Organization > Integrations wins when it is enabled; this is the fallback.
GOOGLE_PLACES_API_KEY=
# Older name for the same key, read only when GOOGLE_PLACES_API_KEY is empty.
# GOOGLE_MAPS_API_KEY=

# ── AI (server/lib/ai.ts) ─────────────────────────────────────────────────────
# The language model summarizes a visit's transcript and proposes sales actions
# from it (server/routes/xpot/helpers.ts, visit-actions.ts). OpenRouter
# first, Gemini as fallback. A key set here overrides the one in
# Organization > Integrations; unset, the panel's key is used. Voice transcription
# (Groq, OpenAI Whisper) is configured in the panel only.
# OPENROUTER_API_KEY=
# Default openai/gpt-4o-mini.
# OPENROUTER_MODEL=
# GEMINI_API_KEY=
# Default gemini-2.5-flash.
# GEMINI_MODEL=

# ── Xphere integration ────────────────────────────────────────────────────────
# Configured PER USER in the app panel (not via env) — each tenant (user) has its
# own inbound key + outbound xph_ token, stored in the xphere_integrations table.
# Nothing to set here. On the Xphere side, set XPOT_API_URL (this app's base URL)
# and XPOT_API_KEY (equal to that user's inbound key shown in the panel).

# ── Tags (QR/NFC pieces) ──────────────────────────────────────────────────────
# Domain printed on the pieces' QR codes and written into their NFC chips.
# Never change it once pieces are printed.
TAG_PUBLIC_BASE_URL=https://xpot.place
# Key for the daily anonymous visitor hash (falls back to one derived from SESSION_SECRET).
TAG_HASH_SECRET=<long-random-string>
# Header a trusted edge sets with the scanner's country (e.g. CF-IPCountry behind
# Cloudflare). Leave unset behind plain Traefik: any client could send it.
# TAG_COUNTRY_HEADER=

# ── AI access (MCP) ───────────────────────────────────────────────────────────
# Optional. Unset, the MCP OAuth issuer and endpoints come from the request's
# origin, so every domain the proxy routes here works. Set it only to force
# one origin (clients connecting through any other domain will then fail).
# PUBLIC_BASE_URL=https://xpot.place

# ── Set by the platform, not by hand ──────────────────────────────────────────
# SOURCE_COMMIT   injected by Coolify; /api/version reports it.
# MIGRATIONS_DIR  where the migration runner looks (default ./migrations).
