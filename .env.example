# PostgreSQL — Xpot uses the SAME Supabase DB as Skale Club for now.
# Migration to a separate Supabase project is a future decision (see README).
POSTGRES_URL=postgres://postgres:password@host:port/db?sslmode=require

# Supabase Auth — reuses Skale Club project (same users table, SSO-friendly).
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Express session
SESSION_SECRET=<long-random-string>

# Server port — client + API are both served from this single port in dev
PORT=2110

# Google Places API (autocomplete for lead addresses)
# Falls back to integration_settings.google_places.apiKey when unset.
GOOGLE_PLACES_API_KEY=

# Vite-exposed canonical origin (used by client to build absolute URLs)
VITE_CANONICAL_ORIGIN=https://xpot.skale.club

# ── Xphere integration ────────────────────────────────────────────────────────
# Configured PER USER in the app panel (not via env) — each tenant (user) has its
# own inbound key + outbound xph_ token, stored in the xphere_integrations table.
# Nothing to set here. On the Xphere side, set XPOT_API_URL (this app's base URL)
# and XPOT_API_KEY (equal to that user's inbound key shown in the panel).
