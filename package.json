{
  "name": "xpot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Xpot | field sales (Visits) and QR/NFC pieces (Tags) for Skale Club reps and resellers; extracted from skaleclub on 2026-05-18",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "npm run migrate:dev && npm run dev:server",
    "dev:server": "cross-env NODE_ENV=development NODE_OPTIONS=--max-http-header-size=131072 tsx server/index.ts",
    "local": "tsx scripts/open-localhost.ts",
    "build": "tsx scripts/build.ts",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:dev": "cross-env NODE_ENV=development tsx scripts/migrate.ts",
    "migrate:dev:plan": "cross-env NODE_ENV=development tsx scripts/migrate.ts --plan",
    "db:pull": "tsx scripts/db-pull.ts",
    "files:migrate": "tsx scripts/migrate-private-files.ts",
    "files:shrink": "tsx scripts/shrink-lead-photos.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seo:og": "tsx scripts/generate-og-image.ts"
  },
